// -----------------------------------------------------
// BribeBank Prisma Schema (Parent + Child Accounts)
// -----------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------
// FAMILY
// One family, many users, rewards, bounties
// -----------------------------------------------------

model Family {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  timezone  String?

  joinCode       String?   @unique
  joinCodeExpiry DateTime?
  passwordRecoveryKeyHash String?
  passwordRecoveryKeyUpdatedAt DateTime?
  wheelSpinCost  Int       @default(1)
  ticketConversionRate Int @default(10) // 10 tickets = $1 by default

  users     User[]
  bounties  Bounty[]
  rewards   Reward[]
  assignedPrizes    AssignedPrize[]
  bountyAssignments BountyAssignment[]
  bountyRecurrenceSeries BountyRecurrenceSeries[]
  historyEvents     HistoryEvent[]
  storeItems        StoreItem[]
  wheelSegments     WheelSegment[]
}

// -----------------------------------------------------
// USER (Parent or Child)
// -----------------------------------------------------

model User {
  id          String     @id @default(cuid())
  familyId    String
  family      Family     @relation(fields: [familyId], references: [id])

  username    String     @unique
  password    String
  displayName String
  role        Role       @default(CHILD) // PARENT or CHILD
  avatarColor String?    @default("bg-blue-500")
  avatarUrl   String?    @db.Text // Optional profile picture URL (base64 data URL) - needs Text for large images
  ticketBalance Int      @default(0)
  sessionVersion Int     @default(0)
  quickLoginPromptSeenAt DateTime?

  createdAt   DateTime   @default(now())

  notifications Notification[]
  claims        Claim[]
  assignedPrizes    AssignedPrize[]
  bountyAssignments BountyAssignment[]
  bountyRecurrenceSeries BountyRecurrenceSeries[]
  historyEvents     HistoryEvent[]
  pushSubscriptions PushSubscription[] 
  passkeyCredentials PasskeyCredential[]
  authChallenges AuthChallenge[]
  authDeviceTokens AuthDeviceToken[]

  @@index([familyId, createdAt])
}

model PasskeyCredential {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String @unique
  publicKey  String
  counter    Int      @default(0)
  transports String?
  aaguid     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

enum AuthChallengeType {
  PASSKEY_REGISTER
  PASSKEY_AUTH
}

model AuthChallenge {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthChallengeType
  challenge  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([type, expiresAt, usedAt])
}

model AuthDeviceToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  deviceKeyId String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([userId, revokedAt])
  @@index([deviceKeyId, revokedAt])
}

//--------------------------------------------------
// PUSH SUBSCRIPTION (App Notifications)
//--------------------------------------------------

model PushSubscription {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  endpoint  String   @unique
  p256dh    String
  auth      String

  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  PARENT
  CHILD
}

enum PrizeStatus {
  AVAILABLE
  PENDING_APPROVAL
  REDEEMED
}

enum PrizeType {
  FOOD
  ACTIVITY
  PRIVILEGE
}

enum BountyStatus {
  OFFERED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  DENIED
}

enum DenialReason {
  NOT_COMPLETED_ADEQUATELY
  TOO_OLD_NO_LONGER_REQUIRED
  NOT_COMPLETED
  INSTRUCTIONS_NOT_FOLLOWED
  LOW_EFFORT
  COMPLETED_AFTER_DEADLINE
}

enum RecurrenceCadence {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrencePattern {
  DAY_OF_WEEK
  DAY_OF_MONTH
}

// -----------------------------------------------------
// BOUNTY (chores / tasks children can do)
// -----------------------------------------------------

model Bounty {
  id         String    @id @default(cuid())
  familyId   String
  family     Family    @relation(fields: [familyId], references: [id])

  title       String
  emoji       String
  rewardType  String?   // "CUSTOM" or "TICKETS"
  rewardValue String   // e.g. "$5" or "Ice Cream" or ticket count
  themeColor      String?  // e.g. "bg-amber-500 text-white"

  rewardTemplateId String?
  rewardTemplate   Reward? @relation("BountyRewardTemplate", fields: [rewardTemplateId], references: [id])

  isFCFS     Boolean   @default(false)
  deadlineHours Int?   // Optional deadline in hours (minimum 1)
  requiresPhoto Boolean @default(false) // Whether photo proof is required before completion
  recurrenceEnabled Boolean @default(false)
  recurrenceCadence RecurrenceCadence?
  recurrencePattern RecurrencePattern?
  recurrenceDayOfWeek Int?
  recurrenceDayOfMonth Int?
  recurrenceWeekOfMonth Int?
  recurrenceMonthOfYear Int?
  streakEnabled Boolean @default(false)

  createdAt  DateTime  @default(now())

  assignments BountyAssignment[]
  streakMilestones BountyStreakMilestone[]
  recurrenceSeries BountyRecurrenceSeries[]

  @@index([familyId, createdAt])  
}

model BountyStreakMilestone {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  threshold  Int
  rewardType String
  rewardValue String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  awards BountyStreakAward[]

  @@unique([bountyId, threshold])
  @@index([bountyId])
}

model BountyRecurrenceSeries {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy String
  active     Boolean  @default(true)
  pausedAt   DateTime?
  autoResumeSkipAt DateTime?
  currentStreak Int   @default(0)
  streakGeneration Int @default(0)
  nextOccurrenceAt DateTime
  currentAssignmentId String?
  currentAssignment BountyAssignment? @relation("SeriesCurrentAssignment", fields: [currentAssignmentId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments BountyAssignment[] @relation("SeriesAssignments")
  streakAwards BountyStreakAward[]

  @@unique([bountyId, userId])
  @@index([familyId, active, pausedAt, nextOccurrenceAt])
  @@index([active, pausedAt, autoResumeSkipAt])
}

// -----------------------------------------------------
// REWARD (redeemable rewards banks)
// -----------------------------------------------------

model Reward {
  id         String    @id @default(cuid())
  familyId   String
  family     Family    @relation(fields: [familyId], references: [id])

  title       String
  emoji       String
  description String?

  type       PrizeType @default(FOOD)
  themeColor String?

  createdAt      DateTime        @default(now())
  claims         Claim[]
  assignedPrizes AssignedPrize[]

  // Back relation to Bounty.rewardTemplate
  bountyTemplates Bounty[] @relation("BountyRewardTemplate")

  @@index([familyId, createdAt])
}

// -----------------------------------------------------
// CLAIM (a child redeems a reward)
// -----------------------------------------------------

model Claim {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  rewardId   String
  reward     Reward    @relation(fields: [rewardId], references: [id])

  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// -----------------------------------------------------
// ASSIGNED PRIZES
// -----------------------------------------------------

model AssignedPrize {
  id          String      @id @default(cuid())
  familyId    String
  family      Family      @relation(fields: [familyId], references: [id])

  templateId  String?
  reward      Reward?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  userId      String
  user        User        @relation(fields: [userId], references: [id])

  assignedBy  String
  status      PrizeStatus @default(AVAILABLE)

  assignedAt  DateTime    @default(now())
  claimedAt   DateTime?
  redeemedAt  DateTime?

  // SNAPSHOT FIELDS – what the child actually sees
  title       String
  emoji       String
  description String?
  type        PrizeType
  themeColor  String?
  streakAwards BountyStreakAward[]

  @@index([familyId, userId, status])
  @@index([userId, status])
  @@index([familyId, assignedAt])
}

// -----------------------------------------------------
// BOUNTY ASSIGNMENTS
// -----------------------------------------------------

model BountyAssignment {
  id          String       @id @default(cuid())
  familyId    String
  family      Family       @relation(fields: [familyId], references: [id])

  bountyId    String
  bounty      Bounty       @relation(fields: [bountyId], references: [id])

  userId      String
  user        User         @relation(fields: [userId], references: [id])

  assignedBy  String
  status      BountyStatus @default(OFFERED)

  assignedAt  DateTime     @default(now())
  completedAt DateTime?
  denialReason DenialReason?
  denialNotes String?      // Optional parent feedback/notes on why task was denied
  deniedAt    DateTime?
  recurrenceSeriesId String?
  recurrenceSeries BountyRecurrenceSeries? @relation("SeriesAssignments", fields: [recurrenceSeriesId], references: [id], onDelete: SetNull)
  seriesCurrentFor BountyRecurrenceSeries[] @relation("SeriesCurrentAssignment")
  occurrenceStartAt DateTime?
  streakCountAtClose Int?
  streakGenerationAtClose Int?
  deadlineStartedAt DateTime?  // When the deadline timer started (when task was accepted)
  deadlineExpiresAt DateTime?  // Calculated deadline expiry time
  deadlineWarningNotified Boolean @default(false) // Track if 1-hour warning notification sent
  photoUrl      String?     @db.Text // Base64 image data or URL of uploaded photo proof
  streakAwards BountyStreakAward[]

  @@index([familyId, userId])
  @@index([familyId, status])
  @@index([recurrenceSeriesId])
  @@index([status, deadlineExpiresAt]) // For deadline monitoring queries
  @@unique([recurrenceSeriesId, occurrenceStartAt])
}

model BountyStreakAward {
  id         String   @id @default(cuid())
  seriesId   String
  series     BountyRecurrenceSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  milestoneId String
  milestone  BountyStreakMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  bountyAssignmentId String
  bountyAssignment BountyAssignment @relation(fields: [bountyAssignmentId], references: [id], onDelete: Cascade)
  streakGeneration Int
  threshold Int
  rewardType String
  rewardValue String
  rewardAssignmentId String?
  rewardAssignment AssignedPrize? @relation(fields: [rewardAssignmentId], references: [id], onDelete: SetNull)
  ticketsAwarded Int?
  createdAt DateTime @default(now())

  @@unique([seriesId, milestoneId, streakGeneration])
  @@index([bountyAssignmentId])
  @@index([rewardAssignmentId])
}

// -----------------------------------------------------
// HISTORY EVENTS
// -----------------------------------------------------

model HistoryEvent {
  id           String   @id @default(cuid())
  familyId     String
  family       Family   @relation(fields: [familyId], references: [id])

  userId       String
  user         User     @relation(fields: [userId], references: [id])

  userName     String
  title        String
  emoji        String
  action       String
  assignerName String
  metadata     String?  // For storing additional context like denial reasons

  createdAt    DateTime @default(now())

  @@index([familyId, userId, createdAt])
}

// -----------------------------------------------------
// NOTIFICATIONS
// -----------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// -----------------------------------------------------
// STORE ITEMS
// -----------------------------------------------------

model StoreItem {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id])

  title       String
  cost        Int
  imageUrl    String?  @db.Text  // Support both external URLs and base64 images
  productUrl  String?
  description String?

  createdAt   DateTime @default(now())

  @@index([familyId, createdAt])
}

// -----------------------------------------------------
// WHEEL SEGMENTS
// -----------------------------------------------------

model WheelSegment {
  id       String @id @default(cuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  label    String
  color    String
  prob     Float  @default(0.1)
  
  createdAt DateTime @default(now())

  @@index([familyId])
}
