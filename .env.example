POSTGRES_USER={REPLACE WITH USERNAME}
POSTGRES_PASSWORD={REPLACE WITH STRONG PASSWORD}
DATABASE_URL=postgresql://{REPLACE WITH USERNAME}:{REPLACE WITH STRONG PASSWORD}@bribebank-db:5432/bribebank?schema=public

JWT_SECRET={REPLACE WITH STRONG SECRET}
CORS_ALLOWED_ORIGINS={OPTIONAL CSV, e.g. http://localhost:5173,http://192.168.10.12:5173}
WEBAUTHN_RP_ID={REPLACE WITH RP ID (e.g. bribebank.mydomain.com)}
WEBAUTHN_ORIGIN={REPLACE WITH WEB ORIGIN (e.g. https://bribebank.mydomain.com)}
WEBAUTHN_RP_NAME=BribeBank

PG_VOLUME_PATH={REPLACE WITH LOCAL POSTGRES PATH}

VITE_API_URL={REPLACE WITH URL FOR API (dev LAN example: http://192.168.10.12:3040)}
VITE_ALLOWED_HOSTS={OPTIONAL CSV, e.g. localhost,127.0.0.1,bribebankdev.homeflixlab.com}

